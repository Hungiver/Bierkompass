        }
    ]

    expanded_deals = []

    for deal in deal_rules:
        start_dt = datetime.strptime(deal["start"], "%Y-%m-%d")
        end_dt = datetime.strptime(deal["end"], "%Y-%m-%d")
        
        curr_dt = start_dt
        while curr_dt <= end_dt:
            # Vasárnap zárva vannak a boltok (kivéve speciális esetek), de a naptárban jelölhetjük
            d_copy = deal.copy()
            d_copy["date"] = curr_dt.strftime("%Y-%m-%d")
            del d_copy["start"]
            del d_copy["end"]
            expanded_deals.append(d_copy)
            curr_dt += timedelta(days=1)

    with open("deals.json", "w", encoding="utf-8") as f:
        json.dump(expanded_deals, f, ensure_ascii=False, indent=2)

    print("deals.json sikeresen frissítve a teljes pontos listával!")

if __name__ == "__main__":
    generate_exact_deals()
