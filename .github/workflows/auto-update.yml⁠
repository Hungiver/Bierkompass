name: Auto Update Beer Deals

on:
  schedule:
    # Lefut minden csütörtökön reggel 05:00 UTC-kor (az osztrák akciók kezdőnapján)
    - cron: '0 5 * * 4'
  workflow_dispatch: # Lehetővé teszi a kézi indítást is a GitHub felületén

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Repo klónozása
      uses: actions/checkout@v3

    - name: Python beállítása
      uses: actions/python-versions@v4
      with:
        python-version: '3.10'

    - name: Függőségek telepítése
      run: |
        python -m pip install --upgrade pip
        pip install requests beautifulsoup4

    - name: Adatgyűjtő szkript futtatása
      run: python scraper.py

    - name: Változtatások mentése és feltöltése (Commit & Push)
      run: |
        git config --global user.name "github-actions[bot]"
        git config --global user.email "github-actions[bot]@users.noreply.github.com"
        git add deals.json
        git commit -m "Auto-update deals.json" || exit 0
        git push
